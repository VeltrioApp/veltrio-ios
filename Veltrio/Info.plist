<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated keys (project.yml). -->
	<!-- DNS-SD services browsed: Chromecasts, Veltrio TVs waiting for settings. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
		<string>_veltrio-pair._tcp</string>
	</array>
	<!-- Addon streams, IPTV providers and media servers are often plain HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
